# ── 서버 ─────────────────────────────────────────────
# server.js 포트 (기본 8123)
PORT=8123

# ── TTS (선택) ───────────────────────────────────────
# 기본값은 브라우저 내장 Web Speech API이며 키가 필요 없다.
# 고품질 사전 생성 음성이 필요할 때만 설정한다.
# 지원: openai
TTS_PROVIDER=
TTS_API_KEY=
# openai 예: alloy(중성), onyx(남성), nova(여성)
TTS_VOICE=
# openai 예: gpt-4o-mini-tts
TTS_MODEL=

# ── LLM (선택: AI 질문 일괄 생성 기능) ─────────────────
# 지원: anthropic | openai
LLM_PROVIDER=
LLM_API_KEY=
# anthropic 예: claude-sonnet-5 / openai 예: gpt-4o-mini
LLM_MODEL=
